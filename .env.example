# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml automatically loads this file's variables.

# Required for the app to actually answer questions / generate embeddings:
OPENAI_API_KEY=sk-your-key-here

# Required for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-real-random-secret

# Optional — only needed if you want Google sign-in working locally
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — only needed for the upload pipeline to actually reach S3.
# For fully local development without AWS, point AWS_S3_ENDPOINT_URL (set
# in backend config, not here) at a MinIO container instead — see README.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=knowledgegpt-uploads-dev
