# Local Docker Compose only. Run scripts/start-local.ps1 to generate JWT_SECRET_KEY.
# Fill GOOGLE_GEMINI_API_KEY locally. Never commit .env or paste its contents.
GOOGLE_GEMINI_API_KEY=
JWT_SECRET_KEY=

# Explicit provider/schema contract; identical in API and Celery.
LLM_PROVIDER=gemini
LLM_CHAT_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_EMBEDDING_DIMENSIONS=1536
# Optional custom endpoint. Leave empty for the Gemini Developer API.
GOOGLE_GEMINI_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
CELERY_CONCURRENCY=1
REGISTRATION_ENABLED=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Leave these empty: Compose supplies LOCAL MinIO defaults, not cloud AWS keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=knowledgegpt-uploads-dev
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Optional Google sign-in, not needed for password registration/login or RAG.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Optional email delivery, not needed for the golden-path password login.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Optional alternate provider only. Never needed by the Gemini path.
OPENAI_API_KEY=
OPENAI_BASE_URL=
