{
  "expo": {
    "name": "KnowledgeGPT",
    "slug": "knowledgegpt",
    "version": "1.0.0",
    "scheme": "knowledgegpt",
    "platforms": ["android"],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.utkarshlabs.knowledgegpt",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {"foregroundImage": "./assets/foreground.png", "backgroundColor": "#103D38"},
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE","android.permission.WRITE_EXTERNAL_STORAGE","android.permission.SYSTEM_ALERT_WINDOW","android.permission.RECORD_AUDIO","android.permission.CAMERA","android.permission.READ_MEDIA_IMAGES","android.permission.READ_MEDIA_VIDEO"]
    },
    "plugins": [
      "expo-router", "expo-secure-store",
      ["expo-splash-screen", {"backgroundColor": "#103D38", "image": "./assets/foreground.png", "imageWidth": 168}],
      ["expo-build-properties", {"android": {"compileSdkVersion": 36, "targetSdkVersion": 36, "usesCleartextTraffic": false}}]
    ]
  }
}
