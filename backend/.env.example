# Optional backend running directly on the HOST, not Compose.
# Use the root .env.example for Docker. Do not copy this over the root .env.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://knowledgegpt:knowledgegpt@localhost:5432/knowledgegpt
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=
LLM_PROVIDER=gemini
LLM_CHAT_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
STARTER_CREDITS=100
CHAT_CREDITS=1
DOCUMENT_CREDITS_PER_PAGE=1
PDF_PAGE_BATCH_SIZE=25
CREDIT_PACKS={}
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LLM_EMBEDDING_DIMENSIONS=1536
REGISTRATION_ENABLED=true
VIRUS_SCAN_ENABLED=true
CLAMAV_HOST=localhost
# Host execution also requires a reachable ClamAV; Compose keeps it internal.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=knowledgegpt-uploads-dev
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
