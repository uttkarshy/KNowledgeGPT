# ---- Core ----
APP_NAME=KnowledgeGPT
ENVIRONMENT=development
DEBUG=true

# ---- LLM Provider selection (the ONLY switch needed to change backends) ----
LLM_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=

# ---- Models (config-driven, never hardcoded in code) ----
LLM_CHAT_MODEL=gpt-4.1
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536

# ---- Generation tunables ----
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- RAG behavior ----
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.72

# ---- Future local providers ----
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
